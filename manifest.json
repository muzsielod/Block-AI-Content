{
  "manifest_version": 3,
  "name": "AI Blocker",
  "version": "0.1.0",
  "description": "Hide AI features and filter unwanted sites from search results, like an ad blocker but for AI.",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "settings.js",
        "domains.js",
        "hiding.js",
        "feature-blocker.js",
        "result-filter.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "rules.json"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "action": {
    "default_title": "AI Blocker",
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "ai-blocker@example.invalid"
    }
  }
}
