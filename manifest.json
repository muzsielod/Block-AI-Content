{
  "manifest_version": 3,
  "name": "AI Blocker",
  "version": "0.3.0",
  "description": "Hide AI features and filter unwanted sites from search results, like an ad blocker but for AI.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "settings.js",
        "domains.js",
        "blocklist.js",
        "hiding.js",
        "notice.js",
        "feature-blocker.js",
        "result-filter.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "rules.json",
        "default-blocklist.json"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "action": {
    "default_title": "AI Blocker",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon-enabled-16.png",
      "32": "icon-enabled-32.png",
      "48": "icon-enabled-48.png",
      "128": "icon-enabled-128.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "ai-blocker@example.invalid"
    }
  },
  "icons": {
    "16": "icon-enabled-16.png",
    "32": "icon-enabled-32.png",
    "48": "icon-enabled-48.png",
    "128": "icon-enabled-128.png"
  },
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "settings.js",
      "background.js"
    ]
  }
}
